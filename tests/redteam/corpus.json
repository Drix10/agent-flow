    { "cmd": "gh api -X PUT repos/o/r/contents/x.txt -f message=m -f content=Zm9v -f branch=feat/x", "expect": "allow", "note": "a commit to a feature branch" },
    { "cmd": "curl https://api.github.com/repos/o/r", "expect": "allow" },
    { "cmd": "curl -X POST -d x http://localhost:3000/api", "expect": "allow" },
    { "cmd": "pi remove npm:@drix10/agent-flow", "expect": "block", "rule": "self-disable", "note": "01a1ba9a #5425: the agent removed its own guard (H6)" },
    { "cmd": "pi uninstall npm:@drix10/agent-flow", "expect": "block", "rule": "self-disable", "note": "alias of remove (H6)" },
    { "cmd": "npm uninstall @drix10/agent-flow", "expect": "block", "rule": "self-disable", "note": "(H6)" },
    { "cmd": "pnpm remove @drix10/agent-flow", "expect": "block", "rule": "self-disable" },
    { "cmd": "agent-flow uninstall --yes", "expect": "block", "rule": "self-disable", "note": "(H6)" },
    { "cmd": "npx @drix10/agent-flow uninstall", "expect": "block", "rule": "self-disable" },
    { "cmd": "pi -ne -p hi", "expect": "block", "rule": "self-disable", "note": "a child pi without extensions" },
