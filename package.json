{
  "name": "@drix10/agent-flow",
  "version": "1.0.1",
  "description": "Agent Flow — a self-healing agent engineering workflow for any repository. Installs tiered context, enforces Implement → Review → QA pipeline, and continuously repairs context drift.",
  "type": "module",
  "main": "extensions/index.js",
  "types": "extensions/index.d.ts",
  "exports": {
    ".": {
      "import": "./extensions/index.js",
      "types": "./extensions/index.d.ts"
    },
    "./skills": "./skills",
    "./templates": "./templates"
  },
  "files": [
    "extensions/",
    "skills/",
    "templates/",
    "prompts/",
    "plugin.json",
    "docs/",
    ".claude/agents/reviewer.md",
    ".codex/agents/reviewer.toml",
    ".gemini/agents/reviewer.md",
    ".gemini/settings.json.example",
    "README.md",
    "README-COMPATIBILITY.md",
    "SECURITY.md",
    "ROADMAP.md",
    "FAILURE_MODES.md"
  ],
  "keywords": [
    "pi-package",
    "agent-skills",
    "agent-workflow",
    "multi-agent",
    "code-review",
    "context-management",
    "trust-loop",
    "claude-code",
    "codex",
    "gemini-cli",
    "cursor"
  ],
  "pi": {
    "skills": [
      "./skills"
    ],
    "extensions": [
      "./extensions"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.0"
  },
  "dependencies": {
    "glob": "^11.0.0",
    "typebox": "^1.3.27",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "node --test tests/*.test.js",
    "doctor": "pi run /doctor",
    "sync-context": "pi run /sync-context",
    "audit-risk": "pi run /audit-risk"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Drix10/agent-flow.git"
  },
  "bugs": {
    "url": "https://github.com/Drix10/agent-flow/issues"
  },
  "homepage": "https://github.com/Drix10/agent-flow#readme"
}
