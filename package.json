{
  "name": "@drix10/agent-flow",
  "version": "1.1.5",
  "description": "Agent Flow — self-healing context + an Implement → Review → QA pipeline with enforced guardrails (Pi) and a zero-dependency CLI for every other harness. Detects context drift, gates risky diffs, keeps the trust signals honest.",
  "type": "module",
  "main": "extensions/index.js",
  "types": "extensions/index.d.ts",
  "exports": {
    ".": {
      "types": "./extensions/index.d.ts",
      "import": "./extensions/index.js"
    },
    "./lib/*": {
      "types": "./extensions/lib/*.d.ts",
      "import": "./extensions/lib/*.js"
    },
    "./skills/*": "./skills/*",
    "./templates/*": "./templates/*",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "extensions/**/*.js",
    "extensions/**/*.d.ts",
    "extensions/**/*.ts",
    "skills/",
    "templates/",
    "schemas/",
    "prompts/",
    "plugin.json",
    ".claude-plugin/plugin.json",
    ".claude-plugin/marketplace.json",
    "gemini-extension.json",
    "docs/",
    ".claude/agents/reviewer.md",
    ".codex/agents/reviewer.toml",
    ".gemini/agents/reviewer.md",
    ".gemini/settings.json.example",
    "README.md",
    "README-COMPATIBILITY.md",
    "SECURITY.md",
    "ROADMAP.md",
    "FAILURE_MODES.md",
    "TRUST_LOOP.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "pi-package",
    "agent-skills",
    "agent-workflow",
    "multi-agent",
    "code-review",
    "context-management",
    "context-drift",
    "agents-md",
    "guardrails",
    "trust-loop",
    "claude-code",
    "codex",
    "gemini-cli",
    "gemini-cli-extension",
    "cursor"
  ],
  "pi": {
    "skills": [
      "./skills"
    ],
    "extensions": [
      "./extensions/index.js"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.0",
    "@types/node": "^22.0.0",
    "typebox": "^1.3.27",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test",
    "prepack": "npm run build",
    "doctor": "node bin/agent-flow.js doctor",
    "audit-risk": "node bin/agent-flow.js audit-risk"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Drix10/agent-flow.git"
  },
  "bugs": {
    "url": "https://github.com/Drix10/agent-flow/issues"
  },
  "homepage": "https://github.com/Drix10/agent-flow#readme",
  "bin": {
    "agent-flow": "bin/agent-flow.js"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
