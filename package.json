{
  "name": "agent-team-workflow",
  "version": "1.0.0",
  "description": "Bootstrap and maintain a self-healing agent engineering team in any repository. Installs tiered context, enforces Implement → Review → QA pipeline, and continuously repairs context drift.",
  "type": "module",
  "main": "extensions/index.js",
  "types": "extensions/index.d.ts",
  "exports": {
    ".": {
      "import": "./extensions/index.js",
      "types": "./extensions/index.d.ts"
    },
    "./skills": "./skills",
    "./templates": "./templates"
  },
  "files": [
    "extensions/",
    "skills/",
    "templates/",
    "README.md",
    "FAILURE_MODES.md"
  ],
  "keywords": [
    "pi-package",
    "agent-skills",
    "agent-workflow",
    "multi-agent",
    "code-review",
    "context-management",
    "trust-loop"
  ],
  "pi": {
    "skills": ["./skills"],
    "extensions": ["./extensions"],
    "templates": ["./templates"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.0"
  },
  "dependencies": {
    "glob": "^11.0.0",
    "typebox": "^1.3.27",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "node --test tests/*.test.js",
    "doctor": "pi run /doctor",
    "sync-context": "pi run /sync-context",
    "audit-risk": "pi run /audit-risk"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Drix10/agent-flow.git"
  },
  "bugs": {
    "url": "https://github.com/Drix10/agent-flow/issues"
  },
  "homepage": "https://github.com/Drix10/agent-flow#readme"
}
